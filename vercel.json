{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/proxy/beehiiv",
      "destination": "https://sloanestephens.beehiiv.com/"
    },
    {
      "source": "/proxy/beehiiv/:path*",
      "destination": "https://sloanestephens.beehiiv.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
